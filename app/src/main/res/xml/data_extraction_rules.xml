<?xml version="1.0" encoding="utf-8"?>
<!--
   SlimTrack keeps the diary, weights and profile on this device only.
   Backup is disabled in the manifest; these rules additionally keep the
   database out of cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
